# Copier en config.env. Aucun secret : pas de compte, pas de mot de passe.
SCRAPER_DB=data/index_web.sqlite3
SCRAPER_PAUSE=3.0
SCRAPER_TIMEOUT=35
SCRAPER_MAX_ERREURS=8
SCRAPER_LIMIT=0
SCRAPER_SOURCE=
SCRAPER_PLAYERS=1
SCRAPER_PROBE=0
SCRAPER_INCREMENTAL=1
SCRAPER_LOG=data/scraper.log

# Parallélisme : 1 instance de Chrome PAR SOURCE (jamais 2 sur le même domaine).
# 0 = autant de workers que de sources actives.
SCRAPER_WORKERS=0

# Sources : liste séparée par des virgules pour forcer l'activation / désactivation
# SCRAPER_ENABLE=monstream,flemmix
# SCRAPER_DISABLE=wawacity

# Wawacity n'a pas de sitemap : 0 = toutes les pages de listing (5098).
SCRAPER_MAX_PAGES=0
SCRAPER_PAGINATION_PAUSE=0.3

# Google Colab : copie de sûreté de la base sur Drive (session limitée à ~12 h).
# SCRAPER_CHECKPOINT=/content/drive/MyDrive/movibot/index_web.sqlite3
SCRAPER_CHECKPOINT_EVERY=100
SCRAPER_PREVIEW_PORT=8090
