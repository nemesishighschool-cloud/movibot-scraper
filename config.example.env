# Réglages LOCAUX (aucun secret). En CI, ces valeurs sont fournies par les
# variables d'environnement des workflows .github/workflows/*.yml.
SCRAPER_DB=data/index_web.sqlite3
SCRAPER_PAUSE=3.0
SCRAPER_TIMEOUT=35
SCRAPER_MAX_ERREURS=8
SCRAPER_LIMIT=0
SCRAPER_SOURCE=
SCRAPER_PLAYERS=1
SCRAPER_PROBE=0
SCRAPER_INCREMENTAL=1
SCRAPER_LOG=data/scraper.log

# 1 worker par source (0 = auto). JAMAIS 2 sur le même domaine.
SCRAPER_WORKERS=0

# Ne pas reconstruire les sitemaps à chaque run (Wawacity = 2 h 30).
# Passer à 1 pour une mise à jour hebdomadaire du catalogue.
SCRAPER_SYNC=0

# Wawacity : 0 = toutes les pages de listing (8 309).
SCRAPER_MAX_PAGES=0
SCRAPER_PAGINATION_PAUSE=0.3

# GitHub Actions : budget < 330 min (limite d'un job = 360 min).
SCRAPER_MAX_MINUTES=0
SCRAPER_CHECKPOINT=
SCRAPER_CHECKPOINT_EVERY=200
SCRAPER_CHECKPOINT_HOOK=

# Sources : forcer l'activation / désactivation (séparées par des virgules)
# SCRAPER_ENABLE=monstream,flemmix
# SCRAPER_DISABLE=wawacity

SCRAPER_PREVIEW_PORT=8090
