[Unit]
Description=MoviBot Scraper — indexation web FrenchStream/FRAnime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/movibot-scraper
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/%i/movibot-scraper/.venv/bin/python -m scraper.cli run --pause 4
Restart=on-failure
RestartSec=120
# Reprise automatique : chaque fiche est déjà marquée faite en base.
StandardOutput=append:/home/%i/movibot-scraper/data/scraper.log
StandardError=append:/home/%i/movibot-scraper/data/scraper.log

[Install]
WantedBy=multi-user.target
